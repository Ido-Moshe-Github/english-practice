{
  "name": "english-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "English of Fun — practise real-life English: everyday conversations, phrasal verbs and tenses",
  "scripts": {
    "start": "npm install --no-audit --no-fund && vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bundle": "vite build --config vite.bundle.config.js && node scripts/bundleSingleFile.js",
    "test": "vitest run",
    "generate": "node scripts/generate.js",
    "review": "node scripts/review.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
